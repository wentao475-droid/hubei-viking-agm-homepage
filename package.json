{
  "name": "hubei-viking-agm-homepage",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "cms": "node scripts/cms-server.mjs",
    "cms:export": "node scripts/export-site-content.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "postprocess:static": "node scripts/postprocess-static-export.mjs",
    "verify:content": "node scripts/verify-content-registry.mjs",
    "verify:assets": "node scripts/verify-public-assets.mjs",
    "build": "next build",
    "build:volcengine": "npm run verify:content && npm run verify:assets && npm run seo:sitemap && npm run build && npm run postprocess:static && npm run verify:static",
    "build:pages": "npm run verify:content && npm run verify:assets && npm run seo:sitemap && npm run build && npm run postprocess:static",
    "verify:static": "node scripts/verify-static-export.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "8.5.14",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
