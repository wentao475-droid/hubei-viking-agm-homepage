PORT=3001
INQUIRY_DB_PATH=/var/lib/viking-agm/inquiries.db
INQUIRY_ALLOWED_ORIGINS=https://www.vikingagm.com,https://vikingagm.com
# Application-level abuse protection. Nginx applies an earlier limit as well.
INQUIRY_RATE_LIMIT_WINDOW_MS=600000
INQUIRY_RATE_LIMIT_MAX=10
# Comma-separated internal addresses. Submissions from these contacts are stored as E-grade tests.
INQUIRY_TEST_CONTACTS=qa@vikingagm.com
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_RETRY_ATTEMPTS=2

# SMTP is the primary notification channel.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Viking AGM Website <your-smtp-user@example.com>"
INQUIRY_TO=vikingsales@vikingagm.com

# Optional: Feishu custom bot webhook for instant notification.
FEISHU_WEBHOOK_URL=

# Internal inquiry admin. Use a long random ADMIN_SESSION_SECRET.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Daily SQLite backup settings. INQUIRY_BACKUP_REMOTE is optional and uses rclone.
INQUIRY_BACKUP_DIR=/var/lib/viking-agm/backups
INQUIRY_BACKUP_RETENTION_DAYS=30
INQUIRY_BACKUP_REMOTE=
