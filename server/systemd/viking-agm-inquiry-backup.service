[Unit]
Description=Back up the Viking AGM inquiry SQLite database
After=viking-agm-inquiry.service

[Service]
Type=oneshot
User=vikingagm
Group=vikingagm
EnvironmentFile=/opt/viking-agm-inquiry/.env
EnvironmentFile=-/etc/viking-agm-backup.env
ExecStart=/opt/viking-agm-inquiry/backup/backup-inquiries.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/viking-agm
